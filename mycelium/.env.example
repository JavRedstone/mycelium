# Gemini (Google AI Studio — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

# Google Cloud (only required for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=mycelium

# GitLab
# Token requires: api scope (read + write)
# Project ID: found at Settings → General → Project ID
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# Agent loop interval (seconds between autonomous runs)
AGENT_LOOP_INTERVAL_SECONDS=600
