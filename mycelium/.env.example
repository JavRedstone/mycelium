# --- Google Cloud / Vertex AI ---
# Auth: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GCS bucket (no gs:// prefix) — only needed for deployment/deploy.py
GOOGLE_CLOUD_STORAGE_BUCKET=

GEMINI_MODEL=gemini-2.5-flash

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB=mycelium

# --- GitLab ---
# Token needs api scope (read + write). Project ID: Settings > General > Project ID
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# --- Pipeline loop ---
# false = server starts without auto-running; use POST /pipeline/run manually
PIPELINE_LOOP_ENABLED=false
# Seconds between runs when loop is enabled
AGENT_LOOP_INTERVAL_SECONDS=600
