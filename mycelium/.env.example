GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=   # only needed for deployment/deploy.py

GEMINI_MODEL=gemini-2.5-flash

MONGODB_URI=
MONGODB_DB=mycelium

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=               # needs api scope (read + write)
GITLAB_PROJECT_ID=          # Settings > General > Project ID

# Loop scheduling and investigator concurrency are set at runtime via
# PATCH /config (Config panel in the UI) and stored in MongoDB.
# No env vars needed - defaults: loop disabled, 600s interval, 10 investigators.

DEMO_MODE=false
